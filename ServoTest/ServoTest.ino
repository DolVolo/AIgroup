// =====================================================================
// โปรแกรมทดสอบเซอร์โว (ไม่ใช้บลูทูธ)
//
// ใช้ตรวจว่าการต่อสายเซอร์โวและไฟเลี้ยงถูกต้องหรือไม่
// เซอร์โวจะขยับทีละตัว: ตัวที่ 1 (D3) -> 2 (D5) -> 3 (D6) -> 4 (D9) แล้ววนใหม่
// เปิด Serial Monitor (9600 baud) เพื่อดูว่าตอนนี้กำลังทดสอบตัวไหน
//
// ฐานหมุนขยับช่วง 45-135 องศา, ไหล่และข้อศอกขยับช่วง 10-90 องศา (ขยับได้จริงไม่เกิน 100)
// ส่วนมือจับขยับแค่ 0-45 องศา ถ้าสั่งเกินช่วงที่ขยับได้จริงจะดันชนโครงจนเซอร์โวร้อน
// ทดสอบเสร็จแล้วอย่าลืมอัปโหลด RobotArm_BT4.ino กลับลงบอร์ด
// =====================================================================

#include <Servo.h>

Servo servos[4];
const int pins[4] = {3, 5, 6, 9};                       // ขาสัญญาณของเซอร์โวแต่ละตัว
const char* names[4] = {"1 Base (D3)", "2 Shoulder (D5)", "3 Elbow (D6)", "4 Gripper (D9)"};

// ช่วงองศาที่ใช้ทดสอบของแต่ละตัว: ต่ำสุด, สูงสุด, ตำแหน่งพัก
const int lowAngle[4]  = {45, 10, 10, 0};
const int highAngle[4] = {135, 90, 90, 45};
const int restAngle[4] = {90, 0, 0, 0};

void setup() {
  Serial.begin(9600);   // เปิดพอร์ต Serial ความเร็ว 9600 baud เพื่อพิมพ์ข้อความออกมาดูใน Serial Monitor
  for (int i = 0; i < 4; i++) {         // วนลูป 4 รอบ ตั้งค่าเซอร์โวทีละตัว (0=ฐาน, 1=ไหล่, 2=ข้อศอก, 3=มือจับ)
    servos[i].attach(pins[i]);          // ผูกเซอร์โวตัวที่ i เข้ากับขาสัญญาณ PWM ตามที่กำหนดไว้ใน pins[]
    servos[i].write(restAngle[i]);      // สั่งเซอร์โวตัวที่ i ไปที่ตำแหน่งพักเริ่มต้นทันที
  }
  Serial.println("Servo test start");   // พิมพ์ข้อความแจ้งว่าเริ่มทดสอบแล้ว
}

void loop() {
  for (int i = 0; i < 4; i++) {                 // วนทดสอบเซอร์โวทีละตัว ตัวที่ 1 ถึง 4 แล้ววนซ้ำไปเรื่อยๆ ไม่มีที่สิ้นสุด
    Serial.print("Testing servo ");             // พิมพ์ข้อความ "Testing servo " นำหน้าชื่อเซอร์โว
    Serial.println(names[i]);                   // พิมพ์ชื่อ/ตำแหน่งขาของเซอร์โวตัวที่กำลังทดสอบ แล้วขึ้นบรรทัดใหม่

    servos[i].write(lowAngle[i]);                // สั่งเซอร์โวไปที่มุมต่ำสุดที่กำหนดไว้ของตัวนั้น
    delay(700);                                  // หยุดรอ 700 มิลลิวินาที ให้เซอร์โวขยับไปถึงตำแหน่งก่อนสั่งต่อ
    servos[i].write(highAngle[i]);               // สั่งเซอร์โวไปที่มุมสูงสุดที่กำหนดไว้ของตัวนั้น
    delay(700);                                  // หยุดรออีก 700 มิลลิวินาที
    servos[i].write(restAngle[i]);               // สั่งเซอร์โวกลับไปที่ตำแหน่งพัก
    delay(700);                                  // หยุดรออีก 700 มิลลิวินาที ก่อนไปทดสอบเซอร์โวตัวถัดไป
  }
}
